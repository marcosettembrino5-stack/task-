# Copia questo file in ".env" solo se vuoi testare con un database in locale.
# In produzione (Koyeb) questa variabile va impostata tra le Environment Variables.
#
# Stringa di connessione Postgres (Neon). Se assente, l'app salva su file JSON locale.
# DATABASE_URL=postgresql://utente:password@host/db?sslmode=require
